{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeCode",
  "version": "1.0.0",
  "identifier": "com.freecode.app",
  "build": {
    "beforeDevCommand": "node server.mjs --port 4321",
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": "node ../../scripts/gen-icons.mjs",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "FreeCode - AI Coding Agent",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0A0A0A",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "deb", "appimage"],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "FreeCode",
    "copyright": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "FreeCode - green terminal AI coding agent",
    "longDescription": "FreeCode is a keyless-free AI coding agent with three personalities: JIM (white-hat mentor), KAI (own-device red-team lab) and ALEX (coding genius). Sharp green #00FF88 on #0A0A0A.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
